# ==========================================
# KiroChaos 3D — AWS & Map Configuration
# ==========================================
# Note: The application operates in high-fidelity simulation mode automatically
# if these credentials are not provided. 100% zero-cost judging experience.

# Amazon Location Service API Key (Optional - enable for live AWS calls)
VITE_AWS_LOCATION_API_KEY=
VITE_AWS_REGION=us-east-2
VITE_AWS_MAP_NAME=KiroNocDarkVectorMap
VITE_AWS_PLACE_INDEX_NAME=KiroNocPlaceIndex
VITE_AWS_ROUTE_CALCULATOR_NAME=KiroNocRouteCalculator

# Amazon Cognito Identity Pool ID (alternative to API Key)
VITE_AWS_COGNITO_IDENTITY_POOL_ID=

# AWS S3 + Apache Iceberg Bucket
VITE_AWS_ICEBERG_S3_URI=s3://kiro-chaos-spatial-lakehouse-prod/iceberg-tables/global_fiber_topology/

# Amazon API Gateway Endpoint (Optional - for persistent chaos incident feed)
VITE_AWS_API_GATEWAY_URL=

